/*
  - DHT11 no pino 2
  - LDR no pino A0
  - LCD I2C 0x27 16x2
  - Joystick VRx=A2 VRy=A3 SW=9
  - LEDs: verde=5, amarelo=4, vermelho=3
  - Buzzer = 6
  - Menu aparece somente se a Temperatura, Umidade e Luminosidaade estiverem OK
  - Se alguma medida errada -> mostra apenas a(s) medida(s) errada(s)
  - LED amarelo pisca 3x + buzzer que apite 3x (ALERTA) | LED vermelho + buzzer (CRÍTICO)
  - Scroll do menu apenas 1x por sessão de “tudo OK”
  - Sem funções externas (apenas setup e loop)
*/

// -------- bibliotecas --------
#include <U8g2lib.h>   // controla o display gráfico ST7920 usando a lib U8g2
#include <RTClib.h>    // controla o módulo de relógio de tempo real (RTC) DS1307
#include "DHT.h"       // controla o sensor de temperatura/umidade DHT

// -------- definições de hardware do DHT --------
#define DHTPIN 2       // pino digital onde o DHT11 está conectado
#define DHTTYPE DHT11  // estamos usando o modelo DHT11
DHT dht(DHTPIN, DHTTYPE); // cria o objeto DHT já dizendo qual pino e qual tipo

// -------- display ST7920 (software SPI) ---------
// U8G2_ST7920_128X64_1_SW_SPI → modo de página (1 page), ST7920, 128x64, SPI por software
// U8G2_R0 → rotação normal
// 13 = EN (clock), 11 = RW (data), 10 = RS (chip select)
U8G2_ST7920_128X64_1_SW_SPI u8g2(U8G2_R0, 13, 11, 10);

// -------- RTC --------
RTC_DS1307 rtc;        // cria o objeto do relógio DS1307

// -------- declara a porta dos leds e buzzer --------
const int ledGreen = 5;   // LED que indica "tudo ok"
const int ledYellow = 4;  // LED que indica "alerta / abaixo do ideal"
const int ledRed = 3;     // LED que indica "crítico / acima do ideal"
const int buzzer = 6;     // buzzer para avisos sonoros

// -------- joystick --------
// Joystick analógico tem 2 eixos (x e y) e 1 botão
// A3 → eixo vertical (vamos usar pra subir/descer no menu)
// A2 → eixo horizontal (vamos usar pra alterar valores na edição)
// 7  → botão do joystick (aperta pra selecionar)
const int joyVert = A3;  // entrada analógica do joystick vertical (navegação)
const int joyHorz = A2;  // entrada analógica do joystick horizontal (edição)
const int joySW   = 7;   // pino do botão do joystick (SW) com pull-up

// -------- LDR --------
const int ldrPin  = A0;  // LDR ligado no A0, leitura analógica de 0 a 1023

// -------- fuso horário --------
// O RTC geralmente é configurado em UTC.
// Aqui guardamos o offset de Brasília, que é UTC-3
// Assim, toda vez que pegarmos a hora do RTC, somamos esse offset.
const int TIMEZONE_OFFSET = -3;

// -------- limites exatos de temperatura, luminosidade e umidade--------
const float tempMin = 12;   // temperatura mínima aceitável (°C)
const float tempMax = 15;   // temperatura máxima aceitável (°C)
const int   umidMin = 60;   // umidade mínima aceitável (%)
const int   umidMax = 80;   // umidade máxima aceitável (%)
const int   lumMin  = 40;   // luminosidade mínima aceitável (%)
const int   lumMax  = 80;   // luminosidade máxima aceitável (%)

// -------- variáveis de leitura --------
// Aqui vamos guardar o último valor lido de cada sensor
float tempC = -999.0;  // -999.0 = código de "sem leitura"
float hum   = -1.0;    // -1 = código de "sem leitura"
int   lum   = 0;       // luminosidade em 0–100%

// -------- estado do sistema / menu --------
bool tudoOk = false;            // indica se T, U e L estão todas dentro do intervalo
int  menuIndex = 0;             // qual item do menu está selecionado (0, 1 ou 2)
unsigned long lastDebounce = 0; // última vez que clicamos (pra debounce do botão)
const unsigned long debounceDelay = 200UL;  // tempo mínimo entre cliques (200 ms)

// -------- temporização da leitura do DHT --------
unsigned long lastDHTreadMillis = 0;        // última vez que lemos o DHT
const unsigned long DHT_INTERVAL = 2000UL;  // ler a cada 2 segundos

// -------- controle da animação do menu --------
bool menuIntroShown = false; // se false, quando tudo ficar ok mostra aqueles 3 itens rolando 1x

// -------- carinhas para fácil entendimento --------
const char HAPPY_FACE[] = ":)";
const char SAD_FACE[]   = ":(";

// -------- função utilitária para desenhar texto alinhado à esquerda --------
void drawStatusLine(int y, const char *text) {
  const int textX = 5;             // sempre 5 px da margem esquerda
  u8g2.drawUTF8(textX, y, text);   // desenha o texto em UTF-8 na posição dada
}

