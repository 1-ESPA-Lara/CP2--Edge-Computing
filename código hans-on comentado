// Função auxiliar para obter hora local de Brasília
DateTime getBrasiliaTime() {
  DateTime utc = rtc.now();                        // lê hora atual do RTC (em UTC)
  return DateTime(utc.unixtime() + (TIMEZONE_OFFSET * 3600)); // converte pra BRT
}

// Inicio do setup
void setup() {
  Serial.begin(115200);      // inicia serial pra debug, 115200 bps

  u8g2.begin();              // inicializa o display U8g2
  u8g2.setContrast(255);     // contraste no máximo (pode baixar se ficar muito forte)

  // -------- animação de abertura --------
  // vamos alterrando 4 vezes entre img_bitmap1 e img_bitmap2
  // cada tela dura 500 ms → 4 * 500 = 2 s de animação
  for (int i = 0; i < 4; i++) {    // repete 4 vezes
    u8g2.firstPage();              // inicia o modo de desenho em páginas
    do {
      // desenha uma das duas imagens, dependendo se i é par ou ímpar
      u8g2.drawXBMP(0, 0, 128, 64, (i % 2 == 0) ? img_bitmap1 : img_bitmap2);
    } while (u8g2.nextPage());     // finaliza a página
    delay(500);                    // espera meio segundo
  }

  // -------- tela de boas-vindas fixa --------
  u8g2.firstPage();
  do {
    u8g2.setFont(u8g2_font_helvB10_tr);        // fonte maior e em negrito
    u8g2.drawStr(16, 28, "BEM-VINDO(a)!");     // mensagem principal
    u8g2.setFont(u8g2_font_helvR08_tr);        // fonte menor
    u8g2.drawStr(10, 45, "Vinheria Agnello");  // nome da vinheria
  } while (u8g2.nextPage());
  delay(2000);                                 // mostra por 2 segundos

  // -------- inicialização do RTC --------
  if (!rtc.begin()) {                          // se não conseguir falar com o RTC...
    // mostra no display que o RTC não foi detectado
    u8g2.firstPage();
    do {
      u8g2.setFont(u8g2_font_6x12_tr);
      u8g2.drawStr(5, 25, "RTC nao detectado");
      u8g2.drawStr(5, 40, "Verifique cabos");
    } while (u8g2.nextPage());
    // e trava o programa aqui, porque sem RTC a parte de horário não faz sentido
    while (1) delay(1000);
  }

  // se o RTC estiver parado (sem bateria ou recém-ligado), configuramos uma hora exemplo
  if (!rtc.isrunning()) {
    Serial.println("RTC parado! Configurando data/hora UTC...");
    // Exemplo de ajuste:
    // 29/10/2025 14:30 em Brasília = 17:30 UTC
    rtc.adjust(DateTime(2025, 10, 29, 17, 30, 0));
  }

  dht.begin();   // inicializa o sensor DHT

  // -------- configura saídas --------
  pinMode(ledGreen, OUTPUT);  digitalWrite(ledGreen, LOW); //garante LED desligado
  pinMode(ledYellow, OUTPUT); digitalWrite(ledYellow, LOW); //garante LED desligado
  pinMode(ledRed, OUTPUT);    digitalWrite(ledRed, LOW); //garante LED desligado
  pinMode(buzzer, OUTPUT);    noTone(buzzer);          // garante buzzer desligado
  pinMode(joySW, INPUT_PULLUP);                        // botão do joystick com pullup

  // mostra que o sistema está pronto
  u8g2.firstPage();
  do {
    u8g2.setFont(u8g2_font_helvR08_tr);
    u8g2.drawStr(15, 35, "Sistema pronto...");
  } while (u8g2.nextPage());
  delay(500);

  // força a primeira leitura do DHT a acontecer logo no primeiro loop
  lastDHTreadMillis = millis() - DHT_INTERVAL;

  Serial.println("Setup concluido");
}

//loop principal
void loop() {
  //le o LDR
  int rawLDR = analogRead(ldrPin);               // lê o valor bruto 0–1023 do LDR
  lum = map(rawLDR, 0, 1023, 0, 100);            // converte para 0–100 %
  if (lum < 0) lum = 0;                          //garante que não sai fora dos limites
  if (lum > 100) lum = 100;                     

  //le o DHT a cada 2 segundos
  if (millis() - lastDHTreadMillis >= DHT_INTERVAL) {  // se passou 2 s...
    lastDHTreadMillis = millis();                      // atualiza o "último tempo"

    float ttemp = dht.readTemperature();               // lê temperatura
    float thum  = dht.readHumidity();                  // lê umidade

    // se a leitura da temperatura falhou (NaN), tenta mais uma vez
    if (isnan(ttemp)) {
      delay(150);
      ttemp = dht.readTemperature();
    }

    // se ainda assim falhou, marcamos a temperatura como inválida
    // se deu certo, ainda verificamos se o valor faz sentido
    if (isnan(ttemp))
      tempC = -999.0;                                  // código de erro
    else
      // proteção: se vier > 60, assumimos que estava em Fahrenheit e convertemos
      tempC = (ttemp > 60.0) ? ((ttemp - 32.0) * 5.0 / 9.0) : ttemp;

    // mesma lógica para umidade
    if (isnan(thum)) {
      delay(150);
      thum = dht.readHumidity();
    }
    hum = isnan(thum) ? -1.0 : thum;                   // -1.0 indica erro

    // calculamos aqui se cada grandeza está ok
    bool tempOk = !(tempC == -999.0 || tempC < tempMin || tempC > tempMax);
    bool humOk  = !(hum < 0.0      || hum   < umidMin || hum   > umidMax);
    bool lumOk  = !(lum            < lumMin || lum    > lumMax);

    // Debug na serial com carinha
    Serial.print("Temp(C): ");
    if (tempC == -999.0) Serial.print("NaN"); else Serial.print(tempC);
    Serial.print(tempOk ? " :)" : " :(");
    Serial.print("  Hum(%): ");
    if (hum < 0) Serial.print("NaN"); else Serial.print(hum);
    Serial.print(humOk ? " :)" : " :(");
    Serial.print("  Lum(%): ");
    Serial.print(lum);
    Serial.println(lumOk ? " :)" : " :(");
  }

  // valida se está as medidas estão dentro do intervalo ideal
  bool tempOk = !(tempC == -999.0 || tempC < tempMin || tempC > tempMax);
  bool humOk  = !(hum < 0.0      || hum   < umidMin || hum   > umidMax);
  bool lumOk  = !(lum            < lumMin || lum    > lumMax);

  // começa assumindo que está tudo ok
  tudoOk = true;
  if (!tempOk) tudoOk = false;   // se temp falhou → não tá ok
  if (!humOk)  tudoOk = false;   // se umid falhou → não tá ok
  if (!lumOk)  tudoOk = false;   // se luz falhou → não tá ok

  // se não estiver ok, ele sai do loop aqui
  if (!tudoOk) {
    menuIntroShown = false;      // marca pra, quando tudo ficar ok de novo, mostrar menu 1x

    bool abaixoIdeal = false, acimaIdeal = false; // flags pra decidir LED/buzzer

    // desenhar a tela de erros
    u8g2.firstPage();
    do {
      // --- Relógio no topo direito ---
      DateTime agora = getBrasiliaTime();
      char horaStr[9];
      sprintf(horaStr, "%02d:%02d", agora.hour(), agora.minute());

      u8g2.setFont(u8g2_font_6x12_tr);
      int16_t x = 128 - u8g2.getStrWidth(horaStr) - 2; 
      u8g2.drawStr(x, 10, horaStr);

      // vamos começar a escrever as linhas de erro a partir de y=14
      u8g2.setFont(u8g2_font_6x12_tr);
      int yPos = 14;

      // --- Temperatura fora dos padrões ---
      if (!tempOk) {
        char tempLine[24];
        if (tempC == -999.0) {
          // se não tinha leitura, mostra "Temp: --.-C :("
          snprintf(tempLine, sizeof(tempLine), "Temp: --.-C %s", SAD_FACE);
        } else {
          // arrumando 1 casa decimal manualmente porque u8g2 algumas vezes tem problemas com float
          int tempInt = (int)(tempC * 10);   // ex: 25.3 -> 253
          int inteiro = tempInt / 10;        // 253 / 10 = 25
          int decimal = tempInt % 10;        // 253 % 10 = 3
          snprintf(tempLine, sizeof(tempLine),
                   "Temp: %d.%dC %s",
                   inteiro,
                   decimal,
                   SAD_FACE);
        }
        drawStatusLine(yPos, tempLine);

        // marca se o problema foi pra baixo ou pra cima
        if (tempC == -999.0 || tempC < tempMin) {
          abaixoIdeal = true;
        } else if (tempC > tempMax) {
          acimaIdeal = true;
        }

        yPos += 16; // próxima linha
      }

      // --- Umidade fora ---
      if (!humOk) {
        char humLine[24];
        if (hum < 0) {
          snprintf(humLine, sizeof(humLine), "Umid: --%% %s", SAD_FACE);
        } else {
          snprintf(humLine, sizeof(humLine), "Umid: %d%% %s", (int)hum, SAD_FACE);
        }
        drawStatusLine(yPos, humLine);

        if (hum < 0.0 || hum < umidMin) {
          abaixoIdeal = true;
        } else if (hum > umidMax) {
          acimaIdeal = true;
        }

        yPos += 16;
      }

      // --- Luz fora ---
      if (!lumOk) {
        char lumLine[24];
        snprintf(lumLine, sizeof(lumLine), "Luz: %d%% %s", lum, SAD_FACE);
        drawStatusLine(yPos, lumLine);

        if (lum < lumMin) {
          abaixoIdeal = true;
        } else if (lum > lumMax) {
          acimaIdeal = true;
        }

        yPos += 16;
      }

    } while (u8g2.nextPage());

    // em caso de niveis fora dos estipulados, vamos acionar os atuadores conforme o nível do erro
    if (acimaIdeal) {
      // ERRO PRA CIMA = crítico
      digitalWrite(ledRed, HIGH);
      digitalWrite(ledYellow, LOW);
      digitalWrite(ledGreen, LOW);
      tone(buzzer, 1000);   // buzzer ligado com 1 kHz
      delay(600);
      noTone(buzzer);
    } else if (abaixoIdeal) {
      // ERRO PRA BAIXO = alerta
      for (int i = 0; i < 3; ++i) {
        digitalWrite(ledYellow, HIGH);
        tone(buzzer, 1500);
        delay(150);
        noTone(buzzer);
        digitalWrite(ledYellow, LOW);
        delay(150);
      }
      // deixa amarelo ligado no final
      digitalWrite(ledYellow, HIGH);
      digitalWrite(ledGreen, LOW);
      digitalWrite(ledRed, LOW);
      noTone(buzzer);
    }

    delay(600);  // dá tempo de ver o alerta
    return;      // sai do loop aqui mesmo (não mostra menu quando tá errado)
  }

  // se entrar nesse loop significa que está tudo ok
  // liga LED verde e garante que o resto tá apagado
  digitalWrite(ledGreen, HIGH);
  digitalWrite(ledYellow, LOW);
  digitalWrite(ledRed, LOW);
  noTone(buzzer);

  // Mostrar o "menu de boas-vindas" só uma vez após voltar pro estado OK ---
  if (!menuIntroShown) {
    for (int scroll = 0; scroll < 3; scroll++) {
      u8g2.firstPage();
      do {
        // relógio no canto
        DateTime agora = getBrasiliaTime();
        char horaStr[9];
        sprintf(horaStr, "%02d:%02d", agora.hour(), agora.minute());
        u8g2.setFont(u8g2_font_6x12_tr);
        int16_t x = 128 - u8g2.getStrWidth(horaStr) - 2;
        u8g2.drawStr(x, 10, horaStr);

        // lista de opções do menu
        u8g2.setFont(u8g2_font_6x12_tr);
        u8g2.drawStr(5, 15, "1: Mudar horario");
        u8g2.drawStr(5, 32, "2: Ver status atual");
        u8g2.drawStr(5, 49, "3: Ver status ideal");
      } while (u8g2.nextPage());
      delay(600);
    }
    menuIntroShown = true;
  }

  // desenha o menu principal
  u8g2.firstPage();
  do {
    // relógio
    DateTime agora = getBrasiliaTime();
    char horaStr[9];
    sprintf(horaStr, "%02d:%02d", agora.hour(), agora.minute());
    u8g2.setFont(u8g2_font_6x12_tr);
    int16_t x = 128 - u8g2.getStrWidth(horaStr) - 2;
    u8g2.drawStr(x, 10, horaStr);

    // desenha as 3 opções com o ">" na selecionada
    u8g2.setFont(u8g2_font_6x12_tr);

    if (menuIndex == 0) {
      u8g2.drawStr(5, 15, "> Mudar horario");
      u8g2.drawStr(5, 32, "  Ver status atual");
    } else if (menuIndex == 1) {
      u8g2.drawStr(5, 15, "  Mudar horario");
      u8g2.drawStr(5, 32, "> Ver status atual");
    } else {
      // se não é 0 nem 1, então é 2
      u8g2.drawStr(5, 32, "  Ver status atual");
    }

    if (menuIndex == 2) {
      u8g2.drawStr(5, 49, "> Ver status ideal");
    } else {
      u8g2.drawStr(5, 49, "  Ver status ideal");
    }
  } while (u8g2.nextPage());

  // ler o joystick para navegar no menu
  int valY = analogRead(joyVert);
  if (valY < 400) {                 // empurrou pra cima
    menuIndex--;
    if (menuIndex < 0) menuIndex = 2;  // volta pro último
    delay(160);                        // pequeno delay pra não pular 10 itens
  }
  else if (valY > 600) {           // empurrou pra baixo
    menuIndex++;
    if (menuIndex > 2) menuIndex = 0;  // volta pro primeiro
    delay(160);
  }

  // se apertar o botão do joystick entra na opção
  if (digitalRead(joySW) == LOW) {             // botão é ativo em LOW por causa do INPUT_PULLUP
    if (millis() - lastDebounce > debounceDelay) {
      lastDebounce = millis();                 // atualiza tempo de debounce

      // opção 0 = mudar horário 
      if (menuIndex == 0) {
        // pega a hora atual de Brasília pra começar a edição com esses valores
        DateTime localTime = getBrasiliaTime();
        int eHour  = localTime.hour();
        int eMin   = localTime.minute();
        int eDay   = localTime.day();
        int eMonth = localTime.month();
        int eYear  = localTime.year();

        int field = 0;               // 0=hora, 1=min, 2=dia, 3=mes, 4=ano
        bool editing = true;

        unsigned long lastMove = 0;
        const unsigned long moveDelay = 160UL; // tempo mínimo entre mudanças com o joy

        // loop de edição
        while (editing) {
          // 1) descobrir quantos dias tem o mês atual (considerando ano bissexto)
          int dim;
          {
            bool leap = ((eYear % 4 == 0) && (eYear % 100 != 0)) || (eYear % 400 == 0);
            if      (eMonth == 1 || eMonth == 3 || eMonth == 5 || eMonth == 7 || eMonth == 8 || eMonth == 10 || eMonth == 12) dim = 31;
            else if (eMonth == 4 || eMonth == 6 || eMonth == 9 || eMonth == 11) dim = 30;
            else dim = leap ? 29 : 28;  // fevereiro
          }
          // se o dia que estamos editando passou do máximo do mês, corrigimos
          if (eDay > dim) eDay = dim;

          // desenha a tela de edição
          u8g2.firstPage();
          do {
            // relógio no canto
            DateTime agora = getBrasiliaTime();
            char horaStr[9];
            sprintf(horaStr, "%02d:%02d", agora.hour(), agora.minute());
            u8g2.setFont(u8g2_font_6x12_tr);
            int16_t x = 128 - u8g2.getStrWidth(horaStr) - 2;
            u8g2.drawStr(x, 10, horaStr);

            u8g2.setFont(u8g2_font_6x12_tr);
            u8g2.drawStr(10, 15, "Editar horario:");

            // mostra qual campo está selecionado
            u8g2.setCursor(20, 35);
            if (field == 0)      u8g2.print("> Hora  ");
            else if (field == 1) u8g2.print("> Min   ");
            else if (field == 2) u8g2.print("> Dia   ");
            else if (field == 3) u8g2.print("> Mes   ");
            else                 u8g2.print("> Ano   ");

            // mostra o valor atual do campo, formatado
            u8g2.setCursor(20, 50);
            if (field < 2) {
              // mostra hora:min
              if (eHour < 10) u8g2.print("0");
              u8g2.print(eHour);
              u8g2.print(":");
              if (eMin < 10) u8g2.print("0");
              u8g2.print(eMin);
            } else if (field < 4) {
              // mostra dia/mes
              if (eDay < 10) u8g2.print("0");
              u8g2.print(eDay);
              u8g2.print("/");
              if (eMonth < 10) u8g2.print("0");
              u8g2.print(eMonth);
            } else {
              // mostra ano
              u8g2.print(eYear);
            }
          } while (u8g2.nextPage());

          // ler joystick dentro da edição
          int y = analogRead(joyVert);   // muda de campo
          int xVal = analogRead(joyHorz);// altera valor do campo
          bool swPressed = (digitalRead(joySW) == LOW); // confirma

          // movimentações só acontecem depois de um pequeno delay (moveDelay)
          if (millis() - lastMove > moveDelay) {
            if (y < 400) {
              // pra cima → campo anterior
              field--;
              if (field < 0) field = 4;
              lastMove = millis();
            } else if (y > 600) {
              // pra baixo → campo seguinte
              field++;
              if (field > 4) field = 0;
              lastMove = millis();
            } else if (xVal < 400) {
              // esquerda → diminui valor
              if (field == 0) { eHour--;  if (eHour  < 0)  eHour  = 23; }
              else if (field == 1) { eMin--;   if (eMin   < 0)  eMin   = 59; }
              else if (field == 2) { eDay--;   if (eDay   < 1)  eDay   = dim; }
              else if (field == 3) { eMonth--; if (eMonth < 1)  eMonth = 12; }
              else { eYear--; if (eYear < 2020) eYear = 2099; }
              lastMove = millis();
            } else if (xVal > 600) {
              // direita → aumenta valor
              if (field == 0) { eHour++;  if (eHour  > 23) eHour  = 0; }
              else if (field == 1) { eMin++;   if (eMin   > 59) eMin   = 0; }
              else if (field == 2) { eDay++;   if (eDay   > dim) eDay   = 1; }
              else if (field == 3) { eMonth++; if (eMonth > 12) eMonth = 1; }
              else { eYear++; if (eYear > 2099) eYear = 2020; }
              lastMove = millis();
            }
          }

          // se apertar o botão dentro da edição → salva e sai
          if (swPressed) {
            if (millis() - lastDebounce > debounceDelay) {
              lastDebounce = millis();

              // monta um DateTime no horário de Brasília
              DateTime brasiliaTime(eYear, eMonth, eDay, eHour, eMin, 0);
              // converte pra UTC (fazendo o inverso do getBrasiliaTime)
              DateTime utcTime(brasiliaTime.unixtime() - (TIMEZONE_OFFSET * 3600));
              // grava no RTC
              rtc.adjust(utcTime);

              // mostra um aviso de "Hora atualizada!"
              u8g2.firstPage();
              do {
                DateTime agora = getBrasiliaTime();
                char horaStr[9];
                sprintf(horaStr, "%02d:%02d", agora.hour(), agora.minute());
                u8g2.setFont(u8g2_font_6x12_tr);
                int16_t x = 128 - u8g2.getStrWidth(horaStr) - 2;
                u8g2.drawStr(x, 10, horaStr);

                u8g2.setFont(u8g2_font_6x12_tr);
                u8g2.drawStr(10, 25, "Hora atualizada!");
                u8g2.setCursor(15, 45);
                if (eDay < 10) u8g2.print("0"); u8g2.print(eDay); u8g2.print("/");
                if (eMonth < 10) u8g2.print("0"); u8g2.print(eMonth); u8g2.print("/");
                u8g2.print(eYear); u8g2.print(" ");
                if (eHour < 10) u8g2.print("0"); u8g2.print(eHour); u8g2.print(":");
                if (eMin  < 10) u8g2.print("0"); u8g2.print(eMin);
              } while (u8g2.nextPage());

              delay(900);
              editing = false; // sai do while(editing)
            }
          }

          delay(40); // pequeno delay pra não ficar lendo de forma muito agressiva
        }
      }

      // opção 1 = ver status atual
      else if (menuIndex == 1) {
        u8g2.firstPage();
        do {
          // relógio
          DateTime agora = getBrasiliaTime();
          char horaStr[9];
          sprintf(horaStr, "%02d:%02d", agora.hour(), agora.minute());
          u8g2.setFont(u8g2_font_6x12_tr);
          int16_t x = 128 - u8g2.getStrWidth(horaStr) - 2;
          u8g2.drawStr(x, 10, horaStr);

          // título
          u8g2.setFont(u8g2_font_helvB08_tr);
          u8g2.drawStr(20, 15, "Status Atual");
          u8g2.setFont(u8g2_font_6x12_tr);

          // temperatura atual
          char tempLine[28];
          if (tempC == -999.0) {
            snprintf(tempLine, sizeof(tempLine), "Temp: --.-C %s", SAD_FACE);
          } else {
            int tempInt = (int)(tempC * 10);
            int inteiro = tempInt / 10;
            int decimal = tempInt % 10;
            snprintf(tempLine, sizeof(tempLine),
                     "Temp: %d.%dC %s",
                     inteiro,
                     decimal,
                     tempOk ? HAPPY_FACE : SAD_FACE);
          }
          drawStatusLine(30, tempLine);

          // umidade atual
          char humLine[28];
          if (hum < 0) {
            snprintf(humLine, sizeof(humLine), "Umid: --%% %s", SAD_FACE);
          } else {
            snprintf(humLine, sizeof(humLine), "Umid: %d%% %s", (int)hum, humOk ? HAPPY_FACE : SAD_FACE);
          }
          drawStatusLine(46, humLine);

          // luz atual
          char lumLine[28];
          snprintf(lumLine, sizeof(lumLine), "Luz:  %d%% %s", lum, lumOk ? HAPPY_FACE : SAD_FACE);
          drawStatusLine(62, lumLine);
        } while (u8g2.nextPage());
        delay(2500); // mostra por 2,5 s
      }

      // opção 2 = ver status ideal
      else if (menuIndex == 2) {
        u8g2.firstPage();
        do {
          // relógio
          DateTime agora = getBrasiliaTime();
          char horaStr[9];
          sprintf(horaStr, "%02d:%02d", agora.hour(), agora.minute());
          u8g2.setFont(u8g2_font_6x12_tr);
          int16_t x = 128 - u8g2.getStrWidth(horaStr) - 2;
          u8g2.drawStr(x, 10, horaStr);

          // título
          u8g2.setFont(u8g2_font_helvB08_tr);
          u8g2.drawStr(20, 15, "Status Ideal");
          u8g2.setFont(u8g2_font_6x12_tr);

          // mostra faixas
          char tempIdeal[28];
          snprintf(tempIdeal, sizeof(tempIdeal),
              "T: %d-%dC",
              (int)tempMin,
              (int)tempMax);
          drawStatusLine(30, tempIdeal);

          char humIdeal[28];
          snprintf(humIdeal, sizeof(humIdeal), "U: %d-%d%%", umidMin, umidMax);
          drawStatusLine(46, humIdeal);

          char lumIdeal[28];
          snprintf(lumIdeal, sizeof(lumIdeal), "L: %d-%d%%", lumMin, lumMax);
          drawStatusLine(62, lumIdeal);
        } while (u8g2.nextPage());
        delay(2500);
      }
    }
  }

  // 10) pequeno delay pra deixar o loop mais estável -------------------------
  delay(100);
}
